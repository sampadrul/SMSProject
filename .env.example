# ─── Twilio ───────────────────────────────────
# Find these at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Optional: use a Messaging Service instead of a phone number
# TWILIO_MESSAGING_SERVICE_SID=

# ─── Google Drive ─────────────────────────────
# Folder ID from the Google Drive URL where photos are stored
GOOGLE_DRIVE_FOLDER_ID=

# OAuth credentials — get these from Google Cloud Console
# (only needed in cloud; locally the app reads from credentials/*.json)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Long-lived refresh token — get this by visiting /google/auth in the app
# (only needed in cloud; locally the app reads from credentials/google-token.json)
GOOGLE_OAUTH_REFRESH_TOKEN=

# ─── App / Auth ───────────────────────────────
# Hash your password: node -e "require('bcryptjs').hash('yourpassword',10).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=

# Random string for signing session cookies (any long random value works)
SESSION_SECRET=

# Port the server listens on (Railway sets this automatically)
PORT=3001

# Directory for the SQLite database (for Railway persistent volumes)
# DATA_DIR=/data
